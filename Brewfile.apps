# GUI applications. Kept apart from the Brewfile so the CLI part installs without them:
#   ./install.sh --no-apps
#   brew bundle --file=~/.dotfiles/Brewfile.apps
#
# Versions are not pinned - a cask is always the latest.

# -- Terminals and editors -----------------------------------------------------
cask "kitty"
cask "iterm2"
cask "visual-studio-code"
cask "karabiner-elements"   # config: karabiner/karabiner.json

# -- Development ---------------------------------------------------------------
cask "docker-desktop"
cask "postgres-unofficial"  # Postgres.app
cask "pgadmin4"
cask "ngrok"
cask "chromedriver"
cask "copilot-cli"
cask "drawio"
cask "figma"

# -- Browser and chat ----------------------------------------------------------
cask "google-chrome"
cask "slack"
cask "telegram"
cask "discord"
cask "zoom"
cask "microsoft-teams"
cask "webex"

# -- AI ------------------------------------------------------------------------
cask "claude"
cask "chatgpt"

# -- Utilities -----------------------------------------------------------------
cask "bartender"
cask "adguard"
cask "coconutbattery"
cask "cleanmymac"
cask "vlc"
cask "obsidian"
cask "loom"
cask "libreoffice"
cask "mendeley-reference-manager"

